# ==============================================================================
# ClimaSentinel Local Configuration Template
# ==============================================================================
# Copy this file to .env for local customization.
# All settings below have sensible defaults for local development.

# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# SQLite database URL. Defaults to sqlite:///<backend_dir>/climasentinel.db
# DATABASE_URL=sqlite:///./climasentinel.db

# Allowed CORS origins for the frontend application (JSON array)
# BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Target backend API base URL for the frontend client (default: http://127.0.0.1:8000)
# VITE_API_URL=http://127.0.0.1:8000

